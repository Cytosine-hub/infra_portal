# Java 业务服务密钥模板，仅注入业务容器。
# 测试配置由 deploy/generate-test-env.sh 基于本模板生成，真实密钥禁止提交到 Git 或 Nacos。
# Gateway 与全部业务服务共享的请求签名密钥，至少 32 UTF-8 字节。
GATEWAY_SIGNING_SECRET=
# 仅在管理员账号表为空时用于创建初始管理员。
ADMIN_DEFAULT_PASSWORD=
# OpenAI 兼容对话模型 API Key；测试配置使用随机占位值，不提供真实模型访问能力。
AI_API_KEY=
# Embedding 模型 API Key；Ollama 本地模式沿用占位值，测试配置会替换为随机值。
EMBEDDING_API_KEY=ollama
# Wiki 导入导出包的签名校验密钥。
WIKI_EXPORT_SIGNATURE_SECRET=
# Zabbix API 登录密码；仅启用 Zabbix 集成时使用。
ZABBIX_PASSWORD=
