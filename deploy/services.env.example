# Java 业务服务密钥模板，仅注入业务容器。
# 测试配置由 deploy/generate-test-env.sh 基于本模板生成，真实密钥禁止提交到 Git 或 Nacos。
# Gateway 与全部业务服务共享的请求签名密钥，至少 32 UTF-8 字节。
GATEWAY_SIGNING_SECRET=
# Comma-separated browser origins; include the deployed frontend URL in production.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080
# 仅在管理员账号表为空时用于创建初始管理员。
ADMIN_DEFAULT_PASSWORD=
# OpenAI 兼容对话模型；真实 API Key 只允许放在部署环境变量中。
AI_BASE_URL=http://ai.tlb.shcj-s.com:8080/v1
AI_API_KEY=
AI_MODEL=gpt-5.6-sol
# 流式响应连续无数据的读取超时；应与模型调用超时保持一致。
LLM_STREAM_READ_TIMEOUT_SECONDS=600
# Embedding 模型 API Key；Ollama 本地模式沿用占位值，测试配置会替换为随机值。
EMBEDDING_API_KEY=ollama
# OpenAI 兼容 Embedding 接口；Docker 部署默认访问同一网络内的 Ollama。
EMBEDDING_BASE_URL=http://ollama:11434/v1
# 模型名与上下文上限必须匹配：bge-large=512，bge-m3=8192。
EMBEDDING_MODEL=bge-m3
EMBEDDING_MAX_TOKENS=8192
# Wiki 导入导出包的签名校验密钥。
WIKI_EXPORT_SIGNATURE_SECRET=
# Zabbix API 登录密码；仅启用 Zabbix 集成时使用。
ZABBIX_PASSWORD=
