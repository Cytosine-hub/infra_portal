# Docker Compose 插值与基础组件配置模板。
# 测试配置由 deploy/generate-test-env.sh 基于本模板生成，禁止直接用于生产。
COMPOSE_PROJECT_NAME=infra-portal
IMAGE_NAMESPACE=infra-portal
IMAGE_TAG=local
BUSINESS_ENV_FILE=./services.env
# 宿主机持久化数据根目录；CI 部署必须使用 Runner 主机上的绝对路径。
DEPLOY_DATA_DIR=/app/infra-portal

FRONTEND_PORT=5173
API_GATEWAY_PORT=8080
COMMUNITY_SERVICE_PORT=8082
AI_SERVICE_PORT=8083
CORE_SERVICE_PORT=8084
MIDDLEWARE_SERVICE_PORT=8085
DATABASE_SERVICE_PORT=8086
HOST_SERVICE_PORT=8087
NETWORK_SERVICE_PORT=8088
SECURITY_SERVICE_PORT=8089
MYSQL_PORT=3306
NACOS_PORT=8848
MILVUS_PORT=19530
MILVUS_WEBUI_PORT=9091
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

MYSQL_VERSION=8.0
NACOS_VERSION=v2.3.2-slim
MILVUS_VERSION=v2.3.4
ETCD_VERSION=v3.5.5
MINIO_VERSION=RELEASE.2023-03-20T20-16-18Z

# MySQL 业务库配置；APP_DB_PASSWORD 是数据库 root 密码，启动前必须设置。
APP_DB_NAME=middleware_resource_manager
APP_DB_USERNAME=root
APP_DB_PASSWORD=
# Nacos namespace/group 用于隔离服务注册和配置。
NACOS_NAMESPACE=
NACOS_CONFIG_GROUP=DEFAULT_GROUP
NACOS_DISCOVERY_GROUP=DEFAULT_GROUP
NACOS_USERNAME=nacos
# Nacos 默认登录密码；当前镜像不会通过环境变量自动修改该账号，测试环境保持 nacos。
NACOS_PASSWORD=nacos
NACOS_AUTH_ENABLE=true
# Nacos 服务端鉴权 Token 与身份键值；测试配置生成器会生成随机值。
NACOS_AUTH_TOKEN=
NACOS_AUTH_IDENTITY_KEY=
NACOS_AUTH_IDENTITY_VALUE=
MINIO_ROOT_USER=minioadmin
# MinIO root 密码；Milvus 使用该账号访问对象存储。
MINIO_ROOT_PASSWORD=
